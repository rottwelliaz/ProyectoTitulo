# Root environment variables for Docker Compose

DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=taller

JWT_SECRET=
JWT_EXPIRE=7d

PORT=3001
NODE_ENV=development

CORS_ORIGIN=http://localhost:3000

PUBLIC_API_URL=http://localhost:3001/api

# Genera JWT_SECRET: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# SEED_DEMO_PASSWORD solo se utiliza al ejecutar manualmente el seed de desarrollo.
