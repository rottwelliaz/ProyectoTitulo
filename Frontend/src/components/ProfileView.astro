---
import ProfileSidebar from './ProfileSidebar.astro';
import SessionNav from './SessionNav.astro';
import ChangePasswordForm from './ChangePasswordForm.astro';
---

<main class="panel-layout profile-root profile-dashboard">
  <ProfileSidebar />

  <section class="profile-main">
    <header class="profile-topbar">
      <div class="profile-page-heading">
        <p>Conce Barber Club</p>
        <h1>Mi perfil</h1>
      </div>

      <div class="profile-top-actions">
        <SessionNav />
      </div>
    </header>

    <div class="profile-content">
      <article class="profile-card profile-identity">
        <div class="profile-photo-wrap">
          <div class="profile-photo" data-user-avatar aria-hidden="true"></div>
          <input id="profile-photo-input" class="profile-photo-input" type="file" accept="image/png,image/jpeg,image/webp" />
          <button id="profile-camera-button" class="profile-camera-button" type="button" aria-label="Cambiar foto">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.5 4h-5L8 6H5a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-3l-1.5-2Z"/><circle cx="12" cy="13" r="3"/></svg>
          </button>
        </div>

        <div class="profile-summary">
          <span class="profile-kicker">Resumen de cuenta</span>
          <h1 id="profile-name">Cargando...</h1>
          <div class="profile-pill">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 21a8 8 0 0 0-16 0"/><circle cx="12" cy="7" r="4"/></svg>
            Perfil: <span id="profile-role">-</span>
          </div>
          <div class="profile-date">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 2v4M16 2v4M3 10h18"/><rect x="3" y="4" width="18" height="18" rx="2"/></svg>
            Desde: <span id="profile-created-at">-</span>
          </div>
        </div>

        <button id="edit-profile-button" class="profile-primary-button" type="button">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20h9"/><path d="m16.5 3.5 4 4L7 21H3v-4L16.5 3.5Z"/></svg>
          Editar perfil
        </button>
      </article>

      <article class="profile-card profile-data-card">
        <div class="profile-panel-header">
          <div>
            <h2>Tus datos personales</h2>
            <p>Revisa y actualiza la información asociada a tu cuenta.</p>
          </div>
        </div>

        <form id="profile-form" class="profile-form">
          <label class="profile-field">
            <span class="profile-field-icon is-blue" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M20 21a8 8 0 0 0-16 0"/><circle cx="12" cy="7" r="4"/></svg>
            </span>
            <span class="profile-field-label">Nombre completo</span>
            <input id="profile-input-nombre" name="nombre" type="text" disabled />
            <button class="profile-edit-button" type="button" data-edit-field="profile-input-nombre">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20h9"/><path d="m16.5 3.5 4 4L7 21H3v-4L16.5 3.5Z"/></svg>
              Editar
            </button>
          </label>

          <label class="profile-field">
            <span class="profile-field-icon is-green" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M4 4h16v16H4z"/><path d="m4 7 8 6 8-6"/></svg>
            </span>
            <span class="profile-field-label">Email</span>
            <input id="profile-input-email" name="email" type="email" disabled />
            <button class="profile-edit-button" type="button" data-edit-field="profile-input-email">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20h9"/><path d="m16.5 3.5 4 4L7 21H3v-4L16.5 3.5Z"/></svg>
              Editar
            </button>
          </label>

          <label class="profile-field">
            <span class="profile-field-icon is-yellow" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2A19.8 19.8 0 0 1 3 5.18 2 2 0 0 1 5 3h3a2 2 0 0 1 2 1.72c.12.9.33 1.77.62 2.6a2 2 0 0 1-.45 2.11L9 10.6a16 16 0 0 0 4.4 4.4l1.17-1.17a2 2 0 0 1 2.11-.45c.83.29 1.7.5 2.6.62A2 2 0 0 1 22 16.92Z"/></svg>
            </span>
            <span class="profile-field-label">Teléfono</span>
            <input id="profile-input-telefono" name="telefono" type="tel" disabled />
            <button class="profile-edit-button" type="button" data-edit-field="profile-input-telefono">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20h9"/><path d="m16.5 3.5 4 4L7 21H3v-4L16.5 3.5Z"/></svg>
              Editar
            </button>
          </label>

          <div id="profile-actions" class="profile-actions">
            <button class="profile-save-button" type="submit">Guardar cambios</button>
            <button id="cancel-profile-button" class="profile-cancel-button" type="button">
              Cancelar
            </button>
          </div>
        </form>

        <p id="profile-message" class="profile-message" aria-live="polite"></p>
      </article>

      <ChangePasswordForm />

      <article id="professional-application" class="profile-card profile-appointments-card is-hidden" data-roles="cliente" hidden>
        <div class="profile-appointments-header"><div>
          <h2>Solicitud de perfil profesional</h2>
          <p id="application-status" aria-live="polite">Cargando solicitud...</p>
        </div></div>
        <div class="profile-actions is-visible">
          <button id="apply-professional" class="profile-save-button" type="button" hidden>Solicitar perfil profesional</button>
          <button id="refresh-application" class="profile-cancel-button" type="button">Actualizar estado</button>
        </div>
      </article>
    </div>
  </section>
</main>

<script>
  import { notifySuccess } from '../lib/notifications';
  import { safePhotoUrl, setPhotoBackground } from '../lib/profilePhoto';
  import { requireSession, authFetch as fetch, API_URL, cacheSessionUser } from '../lib/session';
  void (async () => {
    if (!(await requireSession())) return;

  const token = localStorage.getItem('token');

  const form = document.querySelector<HTMLFormElement>('#profile-form');
  const message = document.querySelector<HTMLParagraphElement>('#profile-message');
  const actions = document.querySelector<HTMLDivElement>('#profile-actions');
  const editProfileButton = document.querySelector<HTMLButtonElement>('#edit-profile-button');
  const cancelProfileButton = document.querySelector<HTMLButtonElement>('#cancel-profile-button');
  const photoButton = document.querySelector<HTMLButtonElement>('#profile-camera-button');
  const photoInput = document.querySelector<HTMLInputElement>('#profile-photo-input');
  const profilePhoto = document.querySelector<HTMLDivElement>('.profile-photo');
  const profileMessagesNav = document.querySelector<HTMLAnchorElement>('#profile-messages-nav');

  const nameTitle = document.querySelector<HTMLHeadingElement>('#profile-name');
  const roleText = document.querySelector<HTMLSpanElement>('#profile-role');
  const createdAtText = document.querySelector<HTMLSpanElement>('#profile-created-at');

  const nombreInput = document.querySelector<HTMLInputElement>('#profile-input-nombre');
  const emailInput = document.querySelector<HTMLInputElement>('#profile-input-email');
  const telefonoInput = document.querySelector<HTMLInputElement>('#profile-input-telefono');
  const inputs = [nombreInput, emailInput, telefonoInput].filter(Boolean) as HTMLInputElement[];

  let currentUser: {
    id: number;
    nombre: string;
    email: string;
    telefono: string | null;
    foto_perfil?: string | null;
    rol: string;
    fecha_creacion: string;
    perfilBarbero?: {
      foto_perfil?: string | null;
    } | null;
  } | null = null;

  const showMessage = (text: string, type: 'success' | 'error' | 'info' = 'info') => {
    if (text && type === 'success') { void notifySuccess(text); text = ''; }
    if (!message) return;
    message.textContent = text;
    message.className = `profile-message is-${type}`;
  };


  const setProfilePhoto = (imageData: string | null) => {
    imageData = safePhotoUrl(imageData);
    [profilePhoto].forEach((element) => {
      if (!element) return;
      setPhotoBackground(element, imageData);
    });
    window.dispatchEvent(new CustomEvent('profile-photo-change', { detail: imageData }));
  };

  const loadSavedPhoto = () => {
    setProfilePhoto(
      safePhotoUrl(currentUser?.foto_perfil) || safePhotoUrl(currentUser?.perfilBarbero?.foto_perfil),
    );
  };

  const setEditing = (enabled: boolean, focusInput?: HTMLInputElement | null) => {
    inputs.forEach((input) => {
      input.disabled = !enabled;
    });

    actions?.classList.toggle('is-visible', enabled);

    if (enabled) {
      window.setTimeout(() => focusInput?.focus(), 0);
    }
  };

  const formatDate = (value: string) => {
    return new Intl.DateTimeFormat('es-CL', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    }).format(new Date(value));
  };

  const renderUser = (user: typeof currentUser) => {
    if (!user) return;

    if (nameTitle) nameTitle.textContent = user.nombre;
    if (roleText) roleText.textContent = user.rol;
    if (createdAtText) createdAtText.textContent = formatDate(user.fecha_creacion);
    if (nombreInput) nombreInput.value = user.nombre;
    if (emailInput) emailInput.value = user.email;
    if (telefonoInput) telefonoInput.value = user.telefono || '';
    setApplicationVisibility(user.rol === 'cliente');
    profileMessagesNav?.classList.toggle('is-hidden', !['cliente', 'barbero'].includes(user.rol));
    if (photoButton) photoButton.hidden = !['cliente', 'barbero'].includes(user.rol);
  };

  const applicationCard = document.querySelector<HTMLElement>('#professional-application');
  const applicationStatus = document.querySelector<HTMLElement>('#application-status');
  const applyButton = document.querySelector<HTMLButtonElement>('#apply-professional');
  const refreshApplication = document.querySelector<HTMLButtonElement>('#refresh-application');
  let canRequestProfessional = false;
  const setApplicationVisibility = (isClient: boolean) => {
    if (applicationCard) applicationCard.hidden = !isClient;
    applicationCard?.classList.toggle('is-hidden', !isClient);
    if (!isClient) {
      canRequestProfessional = false;
      if (applyButton) applyButton.hidden = true;
    }
  };
  const loadApplication = async () => {
    canRequestProfessional = false;
    if (applyButton) applyButton.hidden = true;
    const session = await requireSession(true);
    setApplicationVisibility(session?.rol === 'cliente');
    if (session?.rol !== 'cliente') return;
    try {
      const response = await fetch(API_URL + '/usuarios/solicitud-profesional', { headers: { Authorization: 'Bearer ' + token } });
      const data = await response.json();
      if (!response.ok) throw new Error(data.message || 'No se pudo consultar la solicitud.');
      if (applicationCard?.hidden) return;
      if (applicationStatus) applicationStatus.textContent = !data ? 'Puedes solicitar la habilitación de tu perfil profesional.'
        : data.estado === 'pendiente' ? 'Solicitud pendiente de revisión administrativa.'
        : data.estado === 'aprobada' ? 'Solicitud aprobada. Actualiza la página para acceder al panel profesional.'
        : 'Solicitud rechazada. Motivo: ' + data.motivoRechazo;
      canRequestProfessional = !data;
      if (applyButton) applyButton.hidden = !canRequestProfessional;
    } catch (error) { if (applicationStatus) applicationStatus.textContent = error instanceof Error ? error.message : 'No se pudo cargar la solicitud.'; }
  };
  applyButton?.addEventListener('click', async () => {
    if (applyButton.disabled || !canRequestProfessional || applicationCard?.hidden) return;
    applyButton.disabled = true;
    canRequestProfessional = false;
    try {
      const session = await requireSession(true);
      setApplicationVisibility(session?.rol === 'cliente');
      if (session?.rol !== 'cliente') return;
      const response = await fetch(API_URL + '/usuarios/solicitud-profesional', { method: 'POST', headers: { Authorization: 'Bearer ' + token } });
      const data = await response.json();
      if (!response.ok) throw new Error(data.message || 'No se pudo enviar la solicitud.');
      await requireSession(true);
      await loadProfile();
    } catch (error) { if (applicationStatus) applicationStatus.textContent = error instanceof Error ? error.message : 'No se pudo enviar la solicitud.'; }
    finally { applyButton.disabled = false; }
  });
  refreshApplication?.addEventListener('click', () => void loadApplication());

  const loadProfile = async () => {
    if (!token) {
      window.location.href = '/login';
      return;
    }

    try {
      const response = await fetch(`${API_URL}/auth/me`, {
        headers: {
          Authorization: `Bearer ${token}`,
        },
      });

      const data = await response.json().catch(() => ({}));

      if (!response.ok) {
        throw new Error(data.message || data.error || 'No se pudo cargar el perfil.');
      }

      currentUser = data;
      cacheSessionUser(data);
      renderUser(currentUser);
      loadSavedPhoto();
      await loadApplication();
      showMessage('', 'info');
    } catch (error) {
      const text = error instanceof Error ? error.message : 'Error al cargar el perfil.';
      showMessage(text, 'error');
    }
  };

  editProfileButton?.addEventListener('click', () => {
    setEditing(true, nombreInput);
  });

  photoButton?.addEventListener('click', () => {
    photoInput?.click();
  });

  photoInput?.addEventListener('change', () => {
    const file = photoInput.files?.[0];
    if (!file) return;

    if (!['image/png', 'image/jpeg', 'image/webp'].includes(file.type)) {
      showMessage('Selecciona una fotografía PNG, JPEG o WebP.', 'error');
      photoInput.value = '';
      return;
    }

    if (file.size > 4 * 1024 * 1024) {
      showMessage('La imagen no puede superar 4 MB.', 'error');
      photoInput.value = '';
      return;
    }

    const reader = new FileReader();
    photoInput.disabled = true;
    if (photoButton) photoButton.disabled = true;
    const finishPhotoUpload = () => {
      photoInput.disabled = false;
      photoInput.value = '';
      if (photoButton) photoButton.disabled = false;
    };
    reader.addEventListener('error', () => {
      showMessage('No se pudo leer la fotografía.', 'error');
      finishPhotoUpload();
    });
    reader.addEventListener('load', async () => {
      const imageData = String(reader.result || '');
      try {
          if (!currentUser || !['cliente', 'barbero'].includes(currentUser.rol) || !token) throw new Error('Inicia sesión para actualizar tu fotografía.');
          const response = await fetch(`${API_URL}/auth/me/photo`, {
            method: 'PUT',
            headers: {
              Authorization: `Bearer ${token}`,
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({ foto_perfil: imageData }),
          });
          const data = await response.json().catch(() => ({}));
          if (!response.ok) throw new Error(data.message || 'No se pudo publicar la foto.');
          const normalized = safePhotoUrl(data.foto_perfil);
          if (!normalized) throw new Error('El servidor no devolvió una fotografía válida.');
          currentUser.foto_perfil = normalized;
          setProfilePhoto(normalized);
          showMessage('Foto actualizada en todo tu perfil.', 'success');
      } catch (error) {
        showMessage(error instanceof Error ? error.message : 'No se pudo actualizar la fotografía.', 'error');
      } finally { finishPhotoUpload(); }
    });
    reader.readAsDataURL(file);
  });

  document.querySelectorAll<HTMLButtonElement>('[data-edit-field]').forEach((button) => {
    button.addEventListener('click', () => {
      const input = document.querySelector<HTMLInputElement>(`#${button.dataset.editField}`);
      setEditing(true, input);
    });
  });

  cancelProfileButton?.addEventListener('click', () => {
    renderUser(currentUser);
    setEditing(false);
    showMessage('', 'info');
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();

    if (!token) {
      window.location.href = '/login';
      return;
    }

    const formData = new FormData(form);
    const payload: Record<string, string> = {};
    const nombre = String(formData.get('nombre') || '').trim();
    const email = String(formData.get('email') || '').trim();
    const telefono = String(formData.get('telefono') || '').trim();
    if (nombre) payload.nombre = nombre;
    if (email) payload.email = email;
    if (!nombre || !email) { showMessage('Nombre y email son obligatorios.', 'error'); return; }
    payload.telefono = telefono;

    const saveButton = form.querySelector<HTMLButtonElement>('button[type=submit]');
    if (saveButton?.disabled) return;
    if (saveButton) saveButton.disabled = true;
    try {
      const response = await fetch(`${API_URL}/auth/me`, {
        method: 'PUT',
        headers: {
          'Content-Type': 'application/json',
          Authorization: `Bearer ${token}`,
        },
        body: JSON.stringify(payload),
      });

      const data = await response.json().catch(() => ({}));

      if (!response.ok) {
        throw new Error(data.message || data.error || 'No se pudo actualizar el perfil.');
      }

      currentUser = data;
      cacheSessionUser(data);
      renderUser(currentUser);
      setEditing(false);
      showMessage('Perfil actualizado correctamente.', 'success');
    } catch (error) {
      const text = error instanceof Error ? error.message : 'Error al actualizar el perfil.';
      showMessage(text, 'error');
    } finally { if (saveButton) saveButton.disabled = false; }
  });

  loadProfile();
  })();
</script>
