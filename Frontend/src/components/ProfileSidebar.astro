---
import logoConce from '../assets/logotesis.png';
import { ShieldCheck } from 'lucide-astro';
interface Props { active?: 'perfil' | 'mis-citas' | 'configuracion' | 'mensajes'; showFooter?: boolean; }
const { active = 'perfil', showFooter = true } = Astro.props;
---
  <aside class="profile-sidebar panel-sidebar">
    <a class="profile-brand panel-sidebar-brand" href="/home" aria-label="Conce Barber Club">
      <img
        class="profile-brand-logo"
        src={logoConce.src}
        alt="Conce Barber Club"
      />
    </a>

    <nav class="profile-nav panel-sidebar-nav" aria-label="Navegación de perfil">
      <a class:list={["profile-sidebar-link", { "is-active": active === "perfil" }]} href="/perfil" aria-current={active === "perfil" ? "page" : undefined}>
        <span class="profile-link-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M20 21a8 8 0 0 0-16 0"/><circle cx="12" cy="7" r="4"/></svg>
        </span>
        Perfil
      </a>
      <a class:list={["profile-sidebar-link", { "is-active": active === "mis-citas" }]} href="/mis-citas" data-roles="cliente" aria-current={active === "mis-citas" ? "page" : undefined}>
        <span class="profile-link-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M8 2v4M16 2v4M3 10h18"/><rect x="3" y="4" width="18" height="18" rx="2"/><path d="m9 16 2 2 4-4"/></svg>
        </span>
        Mis citas
      </a>
      <a class:list={["profile-sidebar-link", { "is-active": active === "configuracion" }]} href="/configuracion" aria-current={active === "configuracion" ? "page" : undefined}>
        <span class="profile-link-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M12 15.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Z"/><path d="M19.4 15a1.7 1.7 0 0 0 .34 1.88l.05.05a2 2 0 1 1-2.83 2.83l-.05-.05A1.7 1.7 0 0 0 15 19.4a1.7 1.7 0 0 0-1 .6 1.7 1.7 0 0 0-.4 1.1V21a2 2 0 1 1-4 0v-.1A1.7 1.7 0 0 0 8.6 19.4a1.7 1.7 0 0 0-1.88.34l-.05.05a2 2 0 1 1-2.83-2.83l.05-.05A1.7 1.7 0 0 0 4.6 15a1.7 1.7 0 0 0-.6-1 1.7 1.7 0 0 0-1.1-.4H3a2 2 0 1 1 0-4h-.1A1.7 1.7 0 0 0 4.6 8.6a1.7 1.7 0 0 0-.34-1.88l-.05-.05a2 2 0 1 1 2.83-2.83l.05.05A1.7 1.7 0 0 0 9 4.6a1.7 1.7 0 0 0 1-.6 1.7 1.7 0 0 0 .4-1.1V3a2 2 0 1 1 4 0v.1A1.7 1.7 0 0 0 15.4 4.6a1.7 1.7 0 0 0 1.88-.34l.05-.05a2 2 0 1 1 2.83 2.83l-.05.05A1.7 1.7 0 0 0 19.4 9c.2.38.56.65 1 .6h.6a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1.4Z"/></svg>
        </span>
        Configuración
      </a>
      <a id="profile-messages-nav" class:list={["profile-sidebar-link", { "is-active": active === "mensajes" }]} href="/mensajes" aria-current={active === "mensajes" ? "page" : undefined}>
        <span class="profile-link-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4Z"/><path d="M8 9h8M8 13h5"/></svg>
        </span>
        Mensajes
      </a>
    </nav>

    {showFooter && <div class="profile-sidebar-card panel-sidebar-footer">
      <ShieldCheck size={22} aria-hidden="true" />
      <div>
        <strong>Cuenta personal</strong>
        <span>Gestiona tus datos y reservas.</span>
      </div>
    </div>}
  </aside>
