---
import logoConce from '../assets/logotesis.png';
import ProfessionalCalendar from './calendar/ProfessionalCalendar';
import BarberCalendar from './calendar/BarberCalendar';
import ProfessionalServices from './ProfessionalServices';
import ProfessionalProfileEditor from './ProfessionalProfileEditor';
import ProfessionalStatistics from './ProfessionalStatistics';
import BarberAppointments from './BarberAppointments';
import SessionNav from './SessionNav.astro';
import {
  BriefcaseBusiness,
  ClipboardList,
  UserRound,
  Pencil,
  MessageCircle,
  FileCheck2,
  BadgeCheck,
  Camera,
  Scissors,
  Settings,
} from 'lucide-astro';
---

<main class="pro-root">
  <aside class="pro-sidebar">
    <a class="pro-brand" href="/home" aria-label="Conce Barber Club">
      <img src={logoConce.src} alt="Conce Barber Club" />
    </a>

    <nav class="pro-nav" aria-label="Menú profesional">
      <a class="pro-nav-link is-active" href="#mi-perfil" data-pro-view="mi-perfil" aria-current="page">
        <UserRound class="pro-nav-lucide" size={23} aria-hidden="true" />
        Mi perfil
      </a>
      <a class="pro-nav-link" href="#mi-negocio" data-pro-view="mi-negocio">
        <BriefcaseBusiness class="pro-nav-lucide" size={23} aria-hidden="true" />
        Mi negocio
      </a>
      <a class="pro-nav-link" href="#organizacion" data-pro-view="organizacion">
        <Scissors class="pro-nav-lucide" size={23} aria-hidden="true" />
        Organización
      </a>
      <a class="pro-nav-link" href="#mis-citas" data-pro-view="mis-citas">
        <ClipboardList class="pro-nav-lucide" size={23} aria-hidden="true" />
        Mis citas
      </a>
      <a class="pro-nav-link" href="/mensajes">
        <MessageCircle class="pro-nav-lucide" size={23} aria-hidden="true" />
        Mensajes
      </a>
      <a class="pro-nav-link" href="#configuracion-reservas" data-pro-view="configuracion-reservas">
        <Settings class="pro-nav-lucide" size={23} aria-hidden="true" />
        Configuración
      </a>
    </nav>

    <div class="pro-sidebar-user">
      <div class="pro-mini-avatar" data-user-avatar aria-hidden="true"></div>
      <div>
        <strong id="sidebar-name">Barbero</strong>
        <span id="sidebar-specialty">Perfil profesional</span>
      </div>
      <span class="pro-user-caret" aria-hidden="true"></span>
    </div>
  </aside>

  <section class="pro-main">
    <header class="pro-topbar">
      <div>
        <h1 id="pro-view-title">Mi perfil</h1>
        <p id="pro-view-description">Tu información profesional</p>
      </div>

      <div class="pro-top-actions">
        <a class="pro-edit-button" href="#editar-perfil-profesional" data-pro-view="mi-perfil">
          <Pencil size={18} aria-hidden="true" />
          Editar perfil
        </a>
        <SessionNav />
      </div>
    </header>

    <section id="mi-perfil" class="pro-view" data-pro-panel="mi-perfil" aria-label="Mi perfil">
    <section id="resumen-profesional" class="pro-hero-card">
      <div class="pro-avatar-wrap">
        <div class="pro-avatar" data-user-avatar aria-hidden="true"></div>
        <button class="pro-camera" type="button" aria-label="Cambiar foto de perfil" title="Cambiar foto de perfil">
          <Camera size={21} strokeWidth={2.25} aria-hidden="true" />
        </button>
      </div>

      <div class="pro-identity">
        <div class="pro-name-row">
          <h2 id="professional-name">Cargando...</h2>
          <BadgeCheck class="pro-verified" size={25} strokeWidth={2.4} aria-label="Perfil verificado" role="img" />
        </div>
        <p id="professional-specialty" class="pro-specialty">Perfil profesional</p>
      </div>

      <div class="pro-about">
        <h3>Sobre mi</h3>
        <p id="professional-bio">Sin biografía registrada.</p>
      </div>
    </section>

      <ProfessionalProfileEditor client:only="react" />
    </section>

    <section id="mi-negocio" class="pro-view" data-pro-panel="mi-negocio" aria-label="Mi negocio" hidden>
    <div class="pro-grid">

      <article id="lugar-trabajo" class="pro-panel pro-workplace">
        <div class="pro-panel-header">
          <div>
            <h2>Mi lugar de trabajo</h2>
            <p id="workplace-helper" class="workplace-helper">Todo barbero debe registrar un lugar de trabajo.</p>
          </div>
          <span id="workplace-status" class="workplace-status">Cargando...</span>
        </div>

        <form id="workplace-form" class="workplace-form">
          <label>
            Nombre de la barbería
            <input name="nombre_barberia" type="text" maxlength="100" required placeholder="Ej: Conce Barber Club" />
          </label>
          <label>
            Dirección
            <input name="direccion" type="text" maxlength="180" required placeholder="Ej: Avenida Central 123, Concepción" />
          </label>

          <p id="workplace-message" class="workplace-message" role="status"></p>

          <div class="workplace-actions">
            <button id="save-workplace" class="workplace-primary" type="submit">Crear lugar de trabajo</button>
            <button id="edit-workplace" class="workplace-primary" type="button" hidden>Editar lugar</button>
            <button id="cancel-workplace-edit" type="button" hidden>Cancelar cambios</button>
            <button id="delete-workplace" class="workplace-danger" type="button" hidden>Eliminar lugar</button>
          </div>
        </form>
      </article>

      <article id="datos-bancarios" class="pro-panel pro-banking">
        <div class="pro-panel-header">
          <div>
            <h2>Datos bancarios</h2>
            <p id="banking-helper" class="workplace-helper">Registra los datos para que tus clientes puedan transferir.</p>
          </div>
          <span id="banking-status" class="workplace-status">Cargando...</span>
        </div>

        <form id="banking-form" class="workplace-form banking-form">
          <label>
            Nombre
            <input name="nombre" type="text" maxlength="120" required placeholder="Ej: Francisco Flores" />
          </label>
          <label>
            RUT
            <input name="rut" type="text" maxlength="20" required placeholder="Ej: 12345678-9" />
          </label>
          <label>
            Banco
            <input name="banco" type="text" maxlength="80" required placeholder="Ej: BancoEstado" />
          </label>
          <label>
            Tipo de cuenta
            <input name="tipoCuenta" type="text" maxlength="60" required placeholder="Ej: CuentaRUT" />
          </label>
          <label>
            N.º de cuenta
            <input name="nroCuenta" type="text" maxlength="40" required placeholder="Ej: 123456789" />
          </label>
          <label>
            Correo
            <input name="correo" type="email" maxlength="120" required placeholder="correo@ejemplo.com" />
          </label>

          <p id="banking-message" class="workplace-message" role="status"></p>

          <div class="workplace-actions">
            <button id="save-banking" class="workplace-primary" type="submit">Guardar datos bancarios</button>
            <button id="edit-banking" class="workplace-primary" type="button" hidden>Editar datos</button>
            <button id="cancel-banking-edit" type="button" hidden>Cancelar cambios</button>
          </div>
        </form>
      </article>

    </div>
    </section>

    <section id="organizacion" class="pro-view" data-pro-panel="organizacion" aria-label="Organización" hidden>
      <div class="pro-subnav" role="tablist" aria-label="Organización">
        <button type="button" role="tab" id="tab-horarios" aria-controls="panel-horarios" data-pro-tab="horarios" aria-selected="true">Semana laboral</button>
        <button type="button" role="tab" id="tab-servicios" aria-controls="panel-servicios" data-pro-tab="servicios" aria-selected="false">Servicios</button>
      </div>
      <div id="panel-horarios" class="pro-tab-panel" role="tabpanel" aria-labelledby="tab-horarios" data-pro-tab-panel="horarios">
        <article class="pro-panel"><div class="pro-panel-header"><h2>Organización semanal</h2></div><p>Configura los días, horarios, disponibilidad y descansos de tu semana laboral.</p></article>
        <BarberCalendar client:only="react" />
      </div>
      <div id="panel-servicios" class="pro-tab-panel" role="tabpanel" aria-labelledby="tab-servicios" data-pro-tab-panel="servicios" hidden>
        <ProfessionalServices client:only="react" />
      </div>
    </section>

    <section id="mis-citas" class="pro-view" data-pro-panel="mis-citas" aria-label="Mis citas" hidden>
      <div class="pro-subnav" role="tablist" aria-label="Mis citas">
        <button type="button" role="tab" id="tab-calendario" aria-controls="panel-calendario" data-pro-tab="calendario" aria-selected="true">Calendario y bloqueos</button>
        <button type="button" role="tab" id="tab-reservas" aria-controls="panel-reservas" data-pro-tab="reservas" aria-selected="false">Reservas</button>
        <button type="button" role="tab" id="tab-historial" aria-controls="panel-reservas" data-pro-tab="historial" aria-selected="false">Historial</button>
      </div>
      <ProfessionalStatistics client:only="react" />
      <div id="panel-calendario" class="pro-tab-panel" role="tabpanel" aria-labelledby="tab-calendario" data-pro-tab-panel="calendario">
        <ProfessionalCalendar client:only="react" />
      </div>
      <div id="panel-reservas" class="pro-tab-panel" role="tabpanel" aria-labelledby="tab-reservas" data-pro-tab-panel="reservas" hidden>
        <BarberAppointments client:only="react" />
      </div>
    </section>

    <section id="configuracion-reservas" class="pro-view" data-pro-panel="configuracion-reservas" aria-label="Configuración de reservas" hidden>
      <article class="pro-panel pro-booking-settings">
        <div class="booking-settings-heading">
          <Settings size={20} aria-hidden="true" />
          <h2>Configuración de reservas</h2>
        </div>
        <p><a href="/configuracion">Abrir configuración de cuenta</a></p>

        <div class="booking-settings-content">
          <label class="booking-setting-row" for="requires-proof-switch">
            <span>
              <strong>Solicitar comprobante de pago</strong>
              <small>Decide si los clientes deben adjuntar un comprobante al reservar una hora.</small>
            </span>
            <span class="booking-switch">
              <input id="requires-proof-switch" type="checkbox" role="switch" checked disabled />
              <span aria-hidden="true"></span>
            </span>
          </label>

          <div class="booking-setting-state">
            <FileCheck2 size={21} aria-hidden="true" />
            <div>
              <strong id="proof-setting-title">Comprobante obligatorio</strong>
              <p id="proof-setting-description">Los clientes deberán adjuntar un comprobante para completar su reserva.</p>
            </div>
          </div>

          <p id="proof-setting-message" class="booking-setting-message" role="status" aria-live="polite"></p>
        </div>
      </article>

    </section>
  </section>

</main>

<script>
  import { requireSession, authFetch as fetch, API_URL, cacheSessionUser } from '../lib/session';
  import { safePhotoUrl } from '../lib/profilePhoto';
  void (async () => {
    if (!(await requireSession())) return;

  const token = localStorage.getItem('token');
  const navLinks = document.querySelectorAll<HTMLAnchorElement>('.pro-nav-link[data-pro-view]');
  const views = document.querySelectorAll<HTMLElement>('[data-pro-panel]');
  const titles: Record<string, [string, string]> = {
    'mi-perfil': ['Mi perfil', 'Tu información profesional'],
    'mi-negocio': ['Mi negocio', 'Establecimiento y datos bancarios'],
    organizacion: ['Organización', 'Semana laboral y servicios'],
    'mis-citas': ['Mis citas', 'Reservas, calendario, historial y estadísticas'],
    'configuracion-reservas': ['Configuración', 'Preferencias de reservas'],
  };
  const aliases: Record<string, [string, string?]> = {
    'resumen-profesional': ['mi-perfil'],
    'editar-perfil-profesional': ['mi-perfil'],
    'lugar-trabajo': ['mi-negocio'],
    'datos-bancarios': ['mi-negocio'],
    'agenda-profesional': ['mis-citas', 'calendario'],
    'citas-profesional': ['mis-citas', 'reservas'],
    'servicios-profesional': ['organizacion', 'servicios'],
  };
  const activeTabs: Record<string, string> = { organizacion: 'horarios', 'mis-citas': 'calendario' };
  const selectTab = (view: string, tab: string) => {
    activeTabs[view] = tab;
    const container = document.querySelector<HTMLElement>(`[data-pro-panel="${view}"]`);
    if (!container) return;
    container.querySelectorAll<HTMLElement>('[data-pro-tab]').forEach(button => {
      button.setAttribute('aria-selected', String(button.dataset.proTab === tab));
      button.tabIndex = button.dataset.proTab === tab ? 0 : -1;
    });
    container.querySelectorAll<HTMLElement>('[data-pro-tab-panel]').forEach(panel => {
      panel.hidden = panel.dataset.proTabPanel !== tab && !(tab === 'historial' && panel.dataset.proTabPanel === 'reservas');
      if (panel.dataset.proTabPanel === 'reservas' && view === 'mis-citas') panel.setAttribute('aria-labelledby', tab === 'historial' ? 'tab-historial' : 'tab-reservas');
    });
    if (view === 'mis-citas') window.dispatchEvent(new CustomEvent('professional-appointments-view', { detail: tab === 'historial' ? 'historial' : 'reservas' }));
  };
  const showView = () => {
    const target = decodeURIComponent(location.hash.slice(1));
    const [view, tab] = titles[target] ? [target, undefined] : aliases[target] || ['mi-perfil'];
    views.forEach(panel => { panel.hidden = panel.dataset.proPanel !== view; });
    navLinks.forEach(link => {
      const active = link.dataset.proView === view;
      link.classList.toggle('is-active', active);
      if (active) link.setAttribute('aria-current', 'page'); else link.removeAttribute('aria-current');
    });
    const title = document.querySelector<HTMLElement>('#pro-view-title');
    const description = document.querySelector<HTMLElement>('#pro-view-description');
    if (title) title.textContent = titles[view][0];
    if (description) description.textContent = titles[view][1];
    if (activeTabs[view]) selectTab(view, tab || activeTabs[view]);
    window.scrollTo({ top: 0, behavior: 'instant' });
  };
  document.querySelectorAll<HTMLButtonElement>('[data-pro-tab]').forEach(button => {
    button.addEventListener('click', () => {
      const view = button.closest<HTMLElement>('[data-pro-panel]')?.dataset.proPanel;
      if (view && button.dataset.proTab) selectTab(view, button.dataset.proTab);
    });
    button.addEventListener('keydown', event => {
      if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
      const tabs = Array.from(button.closest<HTMLElement>('[role="tablist"]')?.querySelectorAll<HTMLButtonElement>('[data-pro-tab]') || []);
      if (!tabs.length) return;
      event.preventDefault();
      const index = tabs.indexOf(button);
      const next = event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1 : (index + (event.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length;
      tabs[next].focus();
      tabs[next].click();
    });
  });
  document.querySelectorAll<HTMLAnchorElement>('a[data-pro-view]').forEach(link => {
    link.addEventListener('click', event => {
      event.preventDefault();
      history.pushState(null, '', link.getAttribute('href') || '#mi-perfil');
      showView();
    });
  });
  window.addEventListener('hashchange', showView);
  window.addEventListener('popstate', showView);
  showView();

  const professionalName = document.querySelector<HTMLElement>('#professional-name');
  const professionalSpecialty = document.querySelector<HTMLElement>('#professional-specialty');
  const professionalBio = document.querySelector<HTMLElement>('#professional-bio');
  const sidebarName = document.querySelector<HTMLElement>('#sidebar-name');
  const sidebarSpecialty = document.querySelector<HTMLElement>('#sidebar-specialty');
  const workplaceForm = document.querySelector<HTMLFormElement>('#workplace-form');
  const workplaceStatus = document.querySelector<HTMLElement>('#workplace-status');
  const workplaceHelper = document.querySelector<HTMLElement>('#workplace-helper');
  const workplaceMessage = document.querySelector<HTMLElement>('#workplace-message');
  const saveWorkplaceButton = document.querySelector<HTMLButtonElement>('#save-workplace');
  const editWorkplaceButton = document.querySelector<HTMLButtonElement>('#edit-workplace');
  const cancelWorkplaceButton = document.querySelector<HTMLButtonElement>('#cancel-workplace-edit');
  const deleteWorkplaceButton = document.querySelector<HTMLButtonElement>('#delete-workplace');
  const workplaceNameInput = workplaceForm?.elements.namedItem('nombre_barberia') as HTMLInputElement | null;
  const workplaceAddressInput = workplaceForm?.elements.namedItem('direccion') as HTMLInputElement | null;
  const bankingForm = document.querySelector<HTMLFormElement>('#banking-form');
  const bankingStatus = document.querySelector<HTMLElement>('#banking-status');
  const bankingHelper = document.querySelector<HTMLElement>('#banking-helper');
  const bankingMessage = document.querySelector<HTMLElement>('#banking-message');
  const saveBankingButton = document.querySelector<HTMLButtonElement>('#save-banking');
  const editBankingButton = document.querySelector<HTMLButtonElement>('#edit-banking');
  const cancelBankingButton = document.querySelector<HTMLButtonElement>('#cancel-banking-edit');
  const requiresProofSwitch = document.querySelector<HTMLInputElement>('#requires-proof-switch');
  const proofSettingTitle = document.querySelector<HTMLElement>('#proof-setting-title');
  const proofSettingDescription = document.querySelector<HTMLElement>('#proof-setting-description');
  const proofSettingMessage = document.querySelector<HTMLElement>('#proof-setting-message');
  const bankingInputs = bankingForm
    ? Array.from(bankingForm.querySelectorAll<HTMLInputElement>('input'))
    : [];
  let currentWorkplace: { id: number; nombre_barberia?: string | null; direccion?: string | null } | null = null;
  let currentBankingData: {
    bancoNombre?: string | null;
    bancoRut?: string | null;
    bancoNombreBanco?: string | null;
    bancoTipoCuenta?: string | null;
    bancoNroCuenta?: string | null;
    bancoCorreo?: string | null;
  } | null = null;
  let isEditingWorkplace = false;
  let isEditingBanking = false;
  let currentRequiresProof = true;


  const renderUser = (user: any) => {
    const name = user?.nombre || 'Barbero';
    const profile = user?.perfilBarbero;
    const specialty = profile?.especialidades?.join(' · ') || 'Barbero profesional';

    if (professionalName) professionalName.textContent = name;
    if (professionalSpecialty) professionalSpecialty.textContent = specialty;
    if (professionalBio) professionalBio.textContent = profile?.biografia || 'Sin biografía registrada.';
    if (sidebarName) sidebarName.textContent = name;
    if (sidebarSpecialty) sidebarSpecialty.textContent = specialty;
    renderBanking(profile || null);
    renderBookingSettings(profile?.requiereComprobante ?? true);
  };

  const loadProfessionalProfile = async () => {
    if (!token) {
      window.location.href = '/login';
      return;
    }

    try {
      const response = await fetch(`${API_URL}/auth/me`, {
        headers: { Authorization: `Bearer ${token}` },
      });
      const user = await response.json().catch(() => ({}));

      if (!response.ok) throw new Error(user.message || 'No se pudo cargar el perfil.');
      if (user.rol !== 'barbero') {
        window.location.href = '/home';
        return;
      }

      cacheSessionUser(user);
      renderUser(user);
      window.dispatchEvent(new CustomEvent('profile-photo-change', {
        detail: safePhotoUrl(user.foto_perfil) || safePhotoUrl(user?.perfilBarbero?.foto_perfil),
      }));
    } catch (error) {
      if (professionalBio) professionalBio.textContent = error instanceof Error ? error.message : 'No se pudo cargar el perfil.';
    }
  };

  const setWorkplaceMessage = (message = '', isError = false) => {
    if (!workplaceMessage) return;
    workplaceMessage.textContent = message;
    workplaceMessage.classList.toggle('is-error', isError);
  };

  const hasCompleteBankingData = (bankingData: typeof currentBankingData) =>
    Boolean(
      bankingData?.bancoNombre &&
      bankingData?.bancoRut &&
      bankingData?.bancoNombreBanco &&
      bankingData?.bancoTipoCuenta &&
      bankingData?.bancoNroCuenta &&
      bankingData?.bancoCorreo,
    );

  const setBankingMessage = (message = '', isError = false) => {
    if (!bankingMessage) return;
    bankingMessage.textContent = message;
    bankingMessage.classList.toggle('is-error', isError);
  };

  const setBookingSettingsMessage = (message = '', isError = false) => {
    if (!proofSettingMessage) return;
    proofSettingMessage.textContent = message;
    proofSettingMessage.classList.toggle('is-error', isError);
  };

  const renderBookingSettings = (requiresProof: boolean) => {
    currentRequiresProof = requiresProof;
    if (requiresProofSwitch) {
      requiresProofSwitch.checked = requiresProof;
      requiresProofSwitch.disabled = false;
    }
    if (proofSettingTitle) {
      proofSettingTitle.textContent = requiresProof ? 'Comprobante obligatorio' : 'Reserva sin comprobante';
    }
    if (proofSettingDescription) {
      proofSettingDescription.textContent = requiresProof
        ? 'Los clientes deberán adjuntar un comprobante para completar su reserva.'
        : 'Los clientes podrán completar la reserva sin adjuntar archivos.';
    }
  };

  const setBankingReadonly = (readonly: boolean) => {
    bankingInputs.forEach((input) => {
      input.readOnly = readonly;
    });
  };

  const renderBanking = (bankingData: typeof currentBankingData) => {
    currentBankingData = bankingData;
    isEditingBanking = false;

    const hasData = hasCompleteBankingData(bankingData);
    const values: Record<string, string> = {
      nombre: bankingData?.bancoNombre || '',
      rut: bankingData?.bancoRut || '',
      banco: bankingData?.bancoNombreBanco || '',
      tipoCuenta: bankingData?.bancoTipoCuenta || '',
      nroCuenta: bankingData?.bancoNroCuenta || '',
      correo: bankingData?.bancoCorreo || '',
    };

    bankingInputs.forEach((input) => {
      input.value = values[input.name] || '';
    });
    setBankingReadonly(hasData);

    if (bankingStatus) {
      bankingStatus.textContent = hasData ? 'Registrado' : 'Pendiente';
      bankingStatus.classList.toggle('is-complete', hasData);
    }

    if (bankingHelper) {
      bankingHelper.textContent = hasData
        ? 'Puedes editar estos datos cuando necesites actualizar tu información bancaria.'
        : 'Registra los datos para que tus clientes puedan transferir.';
    }

    if (saveBankingButton) {
      saveBankingButton.hidden = hasData;
      saveBankingButton.textContent = hasData ? 'Guardar cambios' : 'Guardar datos bancarios';
    }
    if (editBankingButton) editBankingButton.hidden = !hasData;
    if (cancelBankingButton) cancelBankingButton.hidden = true;
  };

  const renderWorkplace = (workplace: typeof currentWorkplace) => {
    currentWorkplace = workplace;
    if (!workplaceNameInput || !workplaceAddressInput || !saveWorkplaceButton) return;

    isEditingWorkplace = false;
    workplaceNameInput.value = workplace?.nombre_barberia || '';
    workplaceAddressInput.value = workplace?.direccion || '';
    workplaceNameInput.readOnly = Boolean(workplace);
    workplaceAddressInput.readOnly = Boolean(workplace);
    saveWorkplaceButton.textContent = 'Crear lugar de trabajo';
    saveWorkplaceButton.hidden = Boolean(workplace);

    if (workplaceStatus) {
      workplaceStatus.textContent = workplace ? 'Registrado' : 'Pendiente';
      workplaceStatus.classList.toggle('is-complete', Boolean(workplace));
    }
    if (workplaceHelper) {
      workplaceHelper.textContent = workplace
        ? 'Puedes editar este lugar o eliminarlo para registrar uno nuevo.'
        : 'Debes registrar un lugar de trabajo para completar tu perfil profesional.';
    }
    if (editWorkplaceButton) editWorkplaceButton.hidden = !workplace;
    if (cancelWorkplaceButton) cancelWorkplaceButton.hidden = true;
    if (deleteWorkplaceButton) deleteWorkplaceButton.hidden = !workplace;
  };

  const loadWorkplace = async () => {
    if (!token) return;

    try {
      const response = await fetch(`${API_URL}/lugartrabajo`, {
        headers: { Authorization: `Bearer ${token}` },
      });
      const data = await response.json().catch(() => []);
      if (!response.ok) throw new Error(data.message || 'No se pudo cargar el lugar de trabajo.');
      renderWorkplace(Array.isArray(data) && data.length ? data[0] : null);
    } catch (error) {
      if (workplaceStatus) workplaceStatus.textContent = 'Error';
      setWorkplaceMessage(
        error instanceof Error ? error.message : 'No se pudo cargar el lugar de trabajo.',
        true,
      );
    }
  };

  editWorkplaceButton?.addEventListener('click', () => {
    if (!currentWorkplace || !workplaceNameInput || !workplaceAddressInput || !saveWorkplaceButton) return;
    isEditingWorkplace = true;
    workplaceNameInput.readOnly = false;
    workplaceAddressInput.readOnly = false;
    saveWorkplaceButton.hidden = false;
    saveWorkplaceButton.textContent = 'Guardar cambios';
    editWorkplaceButton.hidden = true;
    if (cancelWorkplaceButton) cancelWorkplaceButton.hidden = false;
    if (deleteWorkplaceButton) deleteWorkplaceButton.hidden = true;
    workplaceNameInput.focus();
    setWorkplaceMessage();
  });

  cancelWorkplaceButton?.addEventListener('click', () => {
    renderWorkplace(currentWorkplace);
    setWorkplaceMessage();
  });

  workplaceForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!token || !workplaceForm || !saveWorkplaceButton) return;

    const formData = new FormData(workplaceForm);
    const payload = {
      nombre_barberia: String(formData.get('nombre_barberia') || '').trim(),
      direccion: String(formData.get('direccion') || '').trim(),
    };
    const isEditing = Boolean(currentWorkplace) && isEditingWorkplace;
    if (currentWorkplace && !isEditing) return;
    const endpoint = isEditing
      ? `${API_URL}/lugartrabajo/${currentWorkplace!.id}`
      : `${API_URL}/lugartrabajo`;

    saveWorkplaceButton.disabled = true;
    saveWorkplaceButton.textContent = 'Guardando...';
    setWorkplaceMessage();

    try {
      const response = await fetch(endpoint, {
        method: isEditing ? 'PUT' : 'POST',
        headers: {
          'Content-Type': 'application/json',
          Authorization: `Bearer ${token}`,
        },
        body: JSON.stringify(payload),
      });
      const data = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(data.message || 'No se pudo guardar el lugar de trabajo.');

      renderWorkplace(data);
      setWorkplaceMessage(isEditing ? 'Lugar de trabajo actualizado.' : 'Lugar de trabajo creado.');
      await loadProfessionalProfile();
    } catch (error) {
      setWorkplaceMessage(
        error instanceof Error ? error.message : 'No se pudo guardar el lugar de trabajo.',
        true,
      );
    } finally {
      saveWorkplaceButton.disabled = false;
      if (!saveWorkplaceButton.hidden) {
        saveWorkplaceButton.textContent = currentWorkplace ? 'Guardar cambios' : 'Crear lugar de trabajo';
      }
    }
  });

  deleteWorkplaceButton?.addEventListener('click', async () => {
    if (!token || !currentWorkplace || !deleteWorkplaceButton) return;
    const confirmed = window.confirm(
      '¿Eliminar este lugar de trabajo? Tendrás que crear otro para completar tu perfil.',
    );
    if (!confirmed) return;

    deleteWorkplaceButton.disabled = true;
    setWorkplaceMessage();

    try {
      const response = await fetch(`${API_URL}/lugartrabajo/${currentWorkplace.id}`, {
        method: 'DELETE',
        headers: { Authorization: `Bearer ${token}` },
      });
      if (!response.ok) {
        const data = await response.json().catch(() => ({}));
        throw new Error(data.message || 'No se pudo eliminar el lugar de trabajo.');
      }

      renderWorkplace(null);
      setWorkplaceMessage('Lugar eliminado. Debes registrar uno nuevo.');
      await loadProfessionalProfile();
    } catch (error) {
      setWorkplaceMessage(
        error instanceof Error ? error.message : 'No se pudo eliminar el lugar de trabajo.',
        true,
      );
    } finally {
      deleteWorkplaceButton.disabled = false;
    }
  });

  editBankingButton?.addEventListener('click', () => {
    if (!saveBankingButton) return;
    isEditingBanking = true;
    setBankingReadonly(false);
    saveBankingButton.hidden = false;
    saveBankingButton.textContent = 'Guardar cambios';
    editBankingButton.hidden = true;
    if (cancelBankingButton) cancelBankingButton.hidden = false;
    bankingInputs[0]?.focus();
    setBankingMessage();
  });

  cancelBankingButton?.addEventListener('click', () => {
    renderBanking(currentBankingData);
    setBankingMessage();
  });

  bankingForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!token || !bankingForm || !saveBankingButton) return;

    const hasData = hasCompleteBankingData(currentBankingData);
    if (hasData && !isEditingBanking) return;

    const formData = new FormData(bankingForm);
    const payload = {
      nombre: String(formData.get('nombre') || '').trim(),
      rut: String(formData.get('rut') || '').trim(),
      banco: String(formData.get('banco') || '').trim(),
      tipoCuenta: String(formData.get('tipoCuenta') || '').trim(),
      nroCuenta: String(formData.get('nroCuenta') || '').trim(),
      correo: String(formData.get('correo') || '').trim(),
    };

    saveBankingButton.disabled = true;
    saveBankingButton.textContent = 'Guardando...';
    setBankingMessage();

    try {
      const response = await fetch(`${API_URL}/auth/me/banking`, {
        method: 'PUT',
        headers: {
          'Content-Type': 'application/json',
          Authorization: `Bearer ${token}`,
        },
        body: JSON.stringify(payload),
      });
      const data = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(data.message || 'No se pudieron guardar los datos bancarios.');

      renderBanking(data);
      setBankingMessage(hasData ? 'Datos bancarios actualizados.' : 'Datos bancarios registrados.');
      await loadProfessionalProfile();
    } catch (error) {
      setBankingMessage(
        error instanceof Error ? error.message : 'No se pudieron guardar los datos bancarios.',
        true,
      );
    } finally {
      saveBankingButton.disabled = false;
      if (!saveBankingButton.hidden) {
        saveBankingButton.textContent = currentBankingData ? 'Guardar cambios' : 'Guardar datos bancarios';
      }
    }
  });

  requiresProofSwitch?.addEventListener('change', async () => {
    if (!token || !requiresProofSwitch) return;

    const requestedValue = requiresProofSwitch.checked;
    requiresProofSwitch.disabled = true;
    setBookingSettingsMessage('Guardando preferencia...');

    try {
      const response = await fetch(`${API_URL}/auth/me/booking-settings`, {
        method: 'PUT',
        headers: {
          'Content-Type': 'application/json',
          Authorization: `Bearer ${token}`,
        },
        body: JSON.stringify({ requiereComprobante: requestedValue }),
      });
      const data = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(data.message || 'No se pudo guardar la configuración.');

      renderBookingSettings(Boolean(data.requiereComprobante));
      setBookingSettingsMessage('Configuración guardada correctamente.');
    } catch (error) {
      renderBookingSettings(currentRequiresProof);
      setBookingSettingsMessage(
        error instanceof Error ? error.message : 'No se pudo guardar la configuración.',
        true,
      );
    } finally {
      requiresProofSwitch.disabled = false;
    }
  });

  document.querySelector('.pro-camera')?.addEventListener('click', () => document.querySelector<HTMLInputElement>('#professional-photo-input')?.click());
  window.addEventListener('professional-profile-updated', () => void loadProfessionalProfile());
  loadProfessionalProfile();
  loadWorkplace();
  })();
</script>
