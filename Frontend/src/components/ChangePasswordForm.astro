---
import { LockKeyhole } from 'lucide-astro';
const fields = [
  { name: 'currentPassword', label: 'Contraseña actual', autocomplete: 'current-password', max: 4096 },
  { name: 'newPassword', label: 'Nueva contraseña', autocomplete: 'new-password', max: 72 },
  { name: 'confirmPassword', label: 'Confirmar nueva contraseña', autocomplete: 'new-password', max: 72 },
];
---

<article class="profile-card profile-data-card" data-roles="cliente barbero admin" hidden aria-labelledby="password-change-heading">
  <div class="profile-panel-header">
    <div>
      <h2 id="password-change-heading">Cambiar contraseña</h2>
      <p>Confirma tu contraseña actual para guardar una nueva.</p>
    </div>
  </div>
  <form id="password-change-form" method="post" novalidate>
    <fieldset class="password-fields profile-form">
      <legend class="sr-only">Cambiar contraseña</legend>
      {fields.map(field => (
        <div class="profile-field">
          <span class="profile-field-icon is-blue" aria-hidden="true"><LockKeyhole size={22} /></span>
          <label class="profile-field-label" for={`password-${field.name}`}>{field.label}</label>
          <input id={`password-${field.name}`} name={field.name} type="password" autocomplete={field.autocomplete}
            minlength={field.name === 'currentPassword' ? undefined : 8}
            maxlength={field.max} required aria-describedby="password-change-help password-change-message" />
        </div>
      ))}
      <p id="password-change-help" class="password-help">La nueva contraseña debe tener al menos 8 caracteres y un máximo de 72 bytes. Las tildes y emojis pueden ocupar varios bytes.</p>
      <label class="password-visibility">
        <input id="password-visibility" type="checkbox" aria-controls="password-currentPassword password-newPassword password-confirmPassword" />
        Mostrar contraseñas
      </label>
      <div class="profile-actions is-visible">
        <button class="profile-save-button" type="submit">Guardar nueva contraseña</button>
      </div>
    </fieldset>
    <p id="password-change-message" class="profile-message password-message" role="status" aria-live="polite" aria-atomic="true"></p>
  </form>
</article>

<script>
  import { notifySuccess } from '../lib/notifications';
  import { API_URL, authFetch } from '../lib/session';
  import { newPasswordError } from '../lib/registration';

  const form = document.querySelector<HTMLFormElement>('#password-change-form');
  const fields = form?.querySelector<HTMLFieldSetElement>('fieldset');
  const current = form?.querySelector<HTMLInputElement>('[name="currentPassword"]');
  const next = form?.querySelector<HTMLInputElement>('[name="newPassword"]');
  const confirm = form?.querySelector<HTMLInputElement>('[name="confirmPassword"]');
  const visibility = form?.querySelector<HTMLInputElement>('#password-visibility');
  const message = form?.querySelector<HTMLElement>('#password-change-message');
  const button = form?.querySelector<HTMLButtonElement>('[type="submit"]');

  const showMessage = (text: string, type: 'success' | 'error') => {
    if (!message) return;
    message.textContent = text;
    message.className = `profile-message password-message is-${type}`;
  };
  const maskPasswords = () => {
    [current, next, confirm].forEach(input => { if (input) input.type = visibility?.checked ? 'text' : 'password'; });
  };
  const clearForm = () => { form?.reset(); maskPasswords(); };
  visibility?.addEventListener('change', maskPasswords);
  window.addEventListener('pagehide', clearForm);

  form?.addEventListener('submit', async event => {
    event.preventDefault();
    if (!current || !next || !confirm || !fields || !button || fields.disabled) return;
    if (!current.value) { showMessage('Ingresa tu contraseña actual.', 'error'); current.focus(); return; }
    const invalid = newPasswordError(next.value);
    if (invalid) { showMessage(invalid, 'error'); next.focus(); return; }
    if (next.value !== confirm.value) { showMessage('Las nuevas contraseñas no coinciden.', 'error'); confirm.focus(); return; }
    if (current.value === next.value) { showMessage('La nueva contraseña debe ser diferente de la actual.', 'error'); next.focus(); return; }

    const payload = { currentPassword: current.value, newPassword: next.value, confirmPassword: confirm.value };
    fields.disabled = true;
    form.setAttribute('aria-busy', 'true');
    button.textContent = 'Guardando...';
    if (message) message.textContent = '';
    const controller = new AbortController();
    const timeout = window.setTimeout(() => controller.abort(), 15000);
    try {
      const response = await authFetch(`${API_URL}/auth/me/password`, {
        method: 'PUT', signal: controller.signal,
        headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${localStorage.getItem('token') || ''}` },
        body: JSON.stringify(payload),
      });
      const data = await response.json().catch(() => null);
      if (!response.ok) {
        showMessage([400, 409, 429].includes(response.status) && typeof data?.message === 'string'
          ? data.message : 'No se pudo cambiar la contraseña. Inténtalo nuevamente.', 'error');
        return;
      }
      if (!data) throw new Error('Invalid response');
      clearForm();
      void notifySuccess('Contraseña actualizada correctamente. Ya puedes iniciar sesión con tu nueva contraseña.');
    } catch {
      if (!localStorage.getItem('token')) {
        clearForm();
        sessionStorage.setItem('password-change-session-expired', 'true');
        showMessage('Tu sesión expiró. Inicia sesión nuevamente.', 'error');
      } else {
        showMessage('No se pudo comunicar con el servidor. Revisa tu conexión e inténtalo nuevamente.', 'error');
      }
    } finally {
      window.clearTimeout(timeout);
      fields.disabled = false;
      form.setAttribute('aria-busy', 'false');
      button.textContent = 'Guardar nueva contraseña';
    }
  });
</script>

<style>
  .password-fields { border: 0; margin: 0; min-width: 0; padding: 0; }
  .password-fields .profile-field { grid-template-columns: 44px minmax(160px, 0.7fr) minmax(0, 1fr); }
  .password-help { color: var(--muted); font-size: 0.88rem; margin: 1rem 0; }
  .password-visibility { align-items: center; display: flex; gap: 0.65rem; }
  .password-visibility input { accent-color: var(--blue); height: 20px; width: 20px; }
  .password-message.is-error { color: #ff8d8d; }
  .password-message.is-success { color: #7de0a3; }
  .password-fields:disabled { opacity: 0.7; }
  @media (max-width: 820px) {
    .password-fields .profile-field { grid-template-columns: 42px minmax(0, 1fr); }
  }
</style>
