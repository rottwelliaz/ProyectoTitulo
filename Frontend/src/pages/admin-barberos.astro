---
import Layout from '../layouts/Layout.astro';
import SessionNav from '../components/SessionNav.astro';
---

<Layout title="Barberos pendientes - Admin">
  <main class="min-h-screen bg-[#020B18] px-6 py-10 text-white">
    <section class="mx-auto max-w-5xl">
      <SessionNav />

      <div class="mt-8 rounded-lg border border-[#0D47A1] bg-[#061B33] p-6 shadow-2xl shadow-black/30">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="text-sm font-black uppercase tracking-[0.18em] text-[#F2C230]">Admin</p>
            <h1 class="mt-2 text-3xl font-black">Barberos pendientes</h1>
            <p class="mt-2 max-w-2xl text-sm leading-6 text-[#C7D2E1]">
              Revisa las solicitudes de cuentas de barbero y apruébalas para habilitar su perfil profesional.
            </p>
          </div>
          <button
            id="refresh-pending-barbers"
            type="button"
            class="rounded-lg border border-[#1261D8] px-5 py-3 text-sm font-black text-white transition hover:border-[#1E6DFF] hover:bg-[#1261D8]"
          >
            Actualizar
          </button>
        </div>

        <p id="admin-message" class="mt-5 hidden rounded-lg px-4 py-3 text-sm font-bold"></p>
        <div id="pending-barbers-list" class="mt-6 grid gap-4"></div>
      </div>
    </section>
  </main>
</Layout>

<style>
  :global(html[data-theme='light']) #pending-barbers-list :is(article, div.rounded-lg) {
    background: #f8fafc;
    border-color: #b8c7dc;
    color: #0f172a;
  }

  :global(html[data-theme='light']) #pending-barbers-list p {
    color: #475569;
  }

  :global(html[data-theme='light']) #refresh-pending-barbers {
    background: #ffffff;
    border-color: #0b63ce;
    color: #0b4eac;
  }

  :global(html[data-theme='light']) #refresh-pending-barbers:hover {
    background: #1261d8;
    color: #ffffff;
  }

  :global(html[data-theme='dark']) #pending-barbers-list :is(article, div.rounded-lg) {
    background: #0c0e12;
    border-color: #46505e;
    color: #f8fafc;
  }

  :global(html[data-theme='dark']) #pending-barbers-list p {
    color: #b8c2d0;
  }

  :global(html[data-theme='dark']) #refresh-pending-barbers {
    background: #15171c;
    border-color: #60a5fa;
    color: #f8fafc;
  }
</style>

<script>
  import { mountCardTable, userOrders } from '../lib/dataTables';
  import { confirmAction, notifyError, notifySuccess } from '../lib/notifications';
  import { escapeHtmlValue as escapeHtml } from '../lib/html';
  import { requireSession, authFetch as fetch, API_URL } from '../lib/session';
  void (async () => {
    if (!(await requireSession())) return;

  const token = localStorage.getItem('token');
  const storedUser = localStorage.getItem('user');
  const list = document.querySelector<HTMLDivElement>('#pending-barbers-list');
  const message = document.querySelector<HTMLParagraphElement>('#admin-message');
  const refreshButton = document.querySelector<HTMLButtonElement>('#refresh-pending-barbers');

  const showMessage = (text: string, type: 'success' | 'error') => {
    if (type === 'success') { void notifySuccess(text); text = ''; }
    if (!message) return;
    message.textContent = text;
    message.className =
      type === 'success'
        ? 'mt-5 rounded-lg border border-green-500/50 bg-green-500/10 px-4 py-3 text-sm font-bold text-green-300'
        : 'mt-5 rounded-lg border border-red-500/50 bg-red-500/10 px-4 py-3 text-sm font-bold text-red-300';
  };

  const getUser = () => {
    try {
      return storedUser ? JSON.parse(storedUser) : null;
    } catch {
      return null;
    }
  };

  const renderPendingBarber = (barber: any) => {
          const date = barber.fecha_creacion ? new Date(barber.fecha_creacion).toLocaleDateString('es-CL') : '-';
          return `
            <article class="grid gap-4 rounded-lg border border-[#0D47A1] bg-[#020B18] p-5 sm:grid-cols-[1fr_auto] sm:items-center">
              <div>
                <h2 class="text-xl font-black">${escapeHtml(barber.nombre)}</h2>
                <p class="mt-1 text-sm text-[#C7D2E1]">${escapeHtml(barber.email)}</p>
                <p class="mt-1 text-sm text-[#C7D2E1]">Teléfono: ${escapeHtml(barber.telefono || 'No registrado')}</p>
                <p class="mt-1 text-sm text-[#C7D2E1]">Rol: ${escapeHtml(barber.rol)} · Solicitud: Pendiente · Estado de aprobación: No aprobado</p>
                <p class="mt-2 text-xs font-bold uppercase tracking-[0.16em] text-[#F2C230]">Solicitado: ${escapeHtml(date)}</p>
              </div>
              <button
                type="button"
                class="approve-barber rounded-lg bg-[#16803A] px-5 py-3 text-sm font-black text-white transition hover:bg-[#1B9C48]"
                data-id="${escapeHtml(barber.id)}"
              >
                Aprobar barbero
              </button>
              <button type="button" class="reject-barber rounded-lg bg-red-800 px-5 py-3 text-sm font-black text-white" data-id="${escapeHtml(barber.id)}">Rechazar solicitud</button>
            </article>
          `;
  };
  let pendingTable: ReturnType<typeof mountCardTable> | undefined;
  const loadPendingBarbers = async () => {
    if (!token || getUser()?.rol !== 'admin' || !list) return;
    if (pendingTable) { pendingTable.reload(); return; }
    pendingTable = mountCardTable(list, { endpoint: '/usuarios/barberos/pendientes', label: 'Solicitudes pendientes', orders: userOrders,
      render: renderPendingBarber, empty: 'No hay barberos pendientes por aprobar.' });
  };

  list?.addEventListener('click', async (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('.approve-barber, .reject-barber');
    if (!button || !token || resolving) return;

    const rejected = button.classList.contains('reject-barber');
    resolving = true;
    try {
      if (rejected && !(await confirmAction('¿Estás seguro de rechazar esta solicitud? La cuenta pendiente será eliminada permanentemente.', 'Sí, rechazar y eliminar'))) return;
      button.disabled = true;
      button.textContent = 'Guardando...';
      const response = await fetch(`${API_URL}/usuarios/${button.dataset.id}/${rejected ? 'rechazar-barbero' : 'aprobar-barbero'}`, {
        method: 'PATCH',
        headers: {
          Authorization: `Bearer ${token}`, 'Content-Type': 'application/json',
        },
      });

      const data = await response.json().catch(() => ({}));
      if (!response.ok) {
        throw new Error(data.message || 'No se pudo aprobar el barbero.');
      }

      showMessage(rejected ? 'La solicitud fue rechazada y la cuenta eliminada correctamente.' : 'El barbero ha sido aprobado correctamente.', 'success');
      await loadPendingBarbers();
    } catch (error) {
      const text = error instanceof Error ? error.message : 'Error al aprobar barbero.';
      void notifyError(text);
      button.disabled = false;
      button.textContent = rejected ? 'Rechazar solicitud' : 'Aprobar barbero';
    } finally { resolving = false; }
  });
  let resolving = false;

  refreshButton?.addEventListener('click', loadPendingBarbers);
  loadPendingBarbers();
  })();
</script>
