---
import '../styles/globals.css';
import { privateRoutes, normalizePath } from '../lib/access';

interface Props {
  title: string;
}

const { title } = Astro.props;
const isPrivate = Boolean(privateRoutes[normalizePath(Astro.url.pathname)]);
---

<!doctype html>
<html lang="es" data-private={isPrivate ? 'true' : undefined} data-auth-state={isPrivate ? 'pending' : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta id="theme-color" name="theme-color" content="#020b18" />
    <script is:inline>
      (() => {
        let savedTheme;
        try { savedTheme = localStorage.getItem('ui-theme'); } catch {}
        const theme = ['original', 'light', 'dark'].includes(savedTheme) ? savedTheme : 'original';
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <title>{title}</title>
  </head>
  <body>
    {isPrivate && <>
      <div class="session-gate" role="status" aria-live="polite">
        <p id="session-status">Comprobando tu sesión…</p>
        <button type="button" id="session-retry">Volver a intentar</button>
        <a href="/login">Iniciar sesión</a>
      </div>
      <noscript><div class="session-noscript">Activa JavaScript para iniciar sesión y acceder a tu cuenta. <a href="/login">Ir al inicio de sesión</a></div></noscript>
    </>}
    <slot />

    <script>
      import { requireSession, watchSession } from '../lib/session';
      import { safePhotoUrl, setPhotoBackground } from '../lib/profilePhoto';
      if (document.documentElement.dataset.private === 'true') {
        void requireSession();
        watchSession();
        document.querySelector('#session-retry')?.addEventListener('click', () => location.reload());
      }
      const updateThemeColor = () => {
        const colors: Record<string, string> = {
          original: '#020b18',
          light: '#f4f7fb',
          dark: '#08090c',
        };
        const theme = document.documentElement.dataset.theme || 'original';
        document.querySelector<HTMLMetaElement>('#theme-color')?.setAttribute('content', colors[theme] || colors.original);
      };

      updateThemeColor();
      window.addEventListener('ui-theme-change', updateThemeColor);
      window.addEventListener('storage', (event) => {
        if (event.key !== 'ui-theme') return;
        const theme = ['original', 'light', 'dark'].includes(event.newValue || '') ? event.newValue! : 'original';
        document.documentElement.dataset.theme = theme;
        updateThemeColor();
      });

      const getSavedUser = () => {
        try {
          return JSON.parse(localStorage.getItem('user') || 'null');
        } catch {
          return null;
        }
      };

      const getCurrentProfilePhoto = () => {
        const user = getSavedUser();
        if (!user?.id) return safePhotoUrl(user?.foto_perfil) || safePhotoUrl(user?.perfilBarbero?.foto_perfil);
        return safePhotoUrl(user?.foto_perfil) || safePhotoUrl(user?.perfilBarbero?.foto_perfil);
      };

      const applyCurrentProfilePhoto = (photo = getCurrentProfilePhoto()) => {
        photo = safePhotoUrl(photo);
        document.querySelectorAll<HTMLElement>('[data-user-avatar]').forEach((avatar) => {
          setPhotoBackground(avatar, photo);
          avatar.querySelector<HTMLElement>('[data-avatar-fallback]')?.classList.toggle('hidden', Boolean(photo));
        });
      };

      applyCurrentProfilePhoto();
      window.addEventListener('profile-photo-change', (event) => {
        applyCurrentProfilePhoto((event as CustomEvent<string | null>).detail || null);
      });
      window.addEventListener('storage', (event) => {
        if (event.key === 'user' || event.key?.startsWith('profile-photo-')) {
          applyCurrentProfilePhoto();
        }
      });

      const prefersReducedMotion = () =>
        window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const PENDING_SCROLL_KEY = 'pending-scroll-target';

      document.addEventListener('click', (event) => {
        const bookingLink = (event.target as HTMLElement).closest<HTMLAnchorElement>('a[href^="/booking"]');
        if (!bookingLink || localStorage.getItem('token')) return;

        event.preventDefault();
        const destination = new URL(bookingLink.href, window.location.origin);
        const redirect = `${destination.pathname}${destination.search}${destination.hash}`;
        window.location.href = `/login?redirect=${encodeURIComponent(redirect)}`;
      });

      const scrollToHash = (hash: string, updateUrl = false) => {
        if (!hash || hash === '#') return false;
        let target: HTMLElement | null = null;
        try { target = document.getElementById(decodeURIComponent(hash.slice(1))); } catch { return false; }
        if (!target) return false;

        target.scrollIntoView({
          behavior: prefersReducedMotion() ? 'auto' : 'smooth',
          block: 'start',
        });

        if (updateUrl) {
          history.pushState(null, '', hash);
        }

        return true;
      };

      const scrollToHashWhenReady = (hash: string, updateUrl = false, attempts = 40) => {
        if (scrollToHash(hash, updateUrl)) return;
        if (attempts <= 0) return;

        window.setTimeout(() => {
          scrollToHashWhenReady(hash, updateUrl, attempts - 1);
        }, 100);
      };

      document.addEventListener('click', (event) => {
        const link = (event.target as HTMLElement).closest<HTMLAnchorElement>('a[href*="#"]');
        if (!link) return;

        const href = link.getAttribute('href');
        if (!href || href === '#') return;

        const url = new URL(href, window.location.href);
        if (url.origin !== window.location.origin) return;
        const samePage =
          url.origin === window.location.origin &&
          url.pathname.replace(/\/$/, '') === window.location.pathname.replace(/\/$/, '');

        if (!samePage) {
          event.preventDefault();
          sessionStorage.setItem(PENDING_SCROLL_KEY, url.hash);
          window.location.href = `${url.pathname}${url.search}`;
          return;
        }

        if (scrollToHash(url.hash, true)) {
          event.preventDefault();
        }
      });

      window.addEventListener('load', () => {
        const pendingHash = sessionStorage.getItem(PENDING_SCROLL_KEY);
        if (pendingHash) {
          sessionStorage.removeItem(PENDING_SCROLL_KEY);
        }

        const hash = pendingHash || window.location.hash;
        if (!hash) return;

        window.setTimeout(() => {
          scrollToHashWhenReady(hash, Boolean(pendingHash));
        }, 0);
      });
    </script>
  </body>
</html>
