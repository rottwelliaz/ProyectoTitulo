generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  cliente
  barbero
  admin
}

enum CitaEstado {
  disponible
  pendiente
  confirmada
  cancelada
  finalizada
  rechazada
  inasistencia
}

model User {
  id             Int      @id @default(autoincrement())
  nombre         String
  email          String   @unique
  password       String
  telefono       String?
  foto_perfil    String?
  rol            UserRole @default(cliente)
  aprobado       Boolean  @default(true)
  activo         Boolean  @default(true)
  fecha_creacion DateTime @default(now())
  fecha_actualizacion DateTime @default(now()) @updatedAt
  cambiosCita CitaCambioEstado[]

  perfilBarbero         BarberProfile?
  citas                 Cita[]         @relation("ClienteCitas")
  conversacionesCliente Conversation[] @relation("ClientConversations")
  conversacionesBarbero Conversation[] @relation("BarberConversations")
  mensajesEnviados      Message[]      @relation("MessageSender")
  solicitudProfesional SolicitudProfesional? @relation("Solicitante")
  solicitudesResueltas SolicitudProfesional[] @relation("Revisor")
}

enum SolicitudEstado {
  pendiente
  aprobada
  rechazada
}

model SolicitudProfesional {
  id Int @id @default(autoincrement())
  usuarioId Int @unique
  usuario User @relation("Solicitante", fields: [usuarioId], references: [id], onDelete: Restrict)
  estado SolicitudEstado @default(pendiente)
  motivoRechazo String?
  fechaSolicitud DateTime @default(now())
  fechaResolucion DateTime?
  revisorId Int?
  revisor User? @relation("Revisor", fields: [revisorId], references: [id], onDelete: Restrict)
}

model AgendaSemana {
  barberoId Int
  barbero BarberProfile @relation(fields: [barberoId], references: [id], onDelete: Restrict)
  inicio DateTime
  configuracion Json
  revision Int @default(1)
  @@id([barberoId, inicio])
}

model BarberProfile {
  id                  Int           @id @default(autoincrement())
  usuarioId           Int           @unique
  usuario             User          @relation(fields: [usuarioId], references: [id])
  biografia           String?
  especialidades      String[]      @default([])
  foto_perfil         String?
  bancoNombre         String?
  bancoRut            String?
  bancoNombreBanco    String?
  bancoTipoCuenta     String?
  bancoNroCuenta      String?
  bancoCorreo         String?
  requiereComprobante Boolean       @default(true)
  lugarTrabajoId      Int?
  lugarTrabajo        LugarTrabajo? @relation(fields: [lugarTrabajoId], references: [id])

  servicios Service[]
  citas     Cita[]    @relation("BarberoCitas")
  bloqueos AgendaBloqueo[]
  semanas AgendaSemana[]
}

model AgendaBloqueo {
  id String @id @default(uuid())
  barberoId Int
  barbero BarberProfile @relation(fields: [barberoId], references: [id], onDelete: Restrict)
  inicio DateTime
  fin DateTime
  tipo String @default("bloqueado")
  origen String @default("manual")
  fecha_creacion DateTime @default(now())

  @@index([barberoId, inicio, fin])
}

model LugarTrabajo {
  id              Int     @id @default(autoincrement())
  nombre_barberia String?
  direccion       String?

  barberos BarberProfile[]
}

model Service {
  id               String        @id @default(uuid())
  perfilBarberoId  Int
  perfilBarbero    BarberProfile @relation(fields: [perfilBarberoId], references: [id])
  nombre_servicio  String
  descripcion      String?
  precio           Int
  duracion_minutos Int
  activo           Boolean @default(true)
  fecha_creacion   DateTime @default(now())
  fecha_actualizacion DateTime @default(now()) @updatedAt
  citas            Cita[]
}

model Cita {
  id                       String        @id @default(uuid())
  clienteId                Int?
  cliente                  User?         @relation("ClienteCitas", fields: [clienteId], references: [id], onDelete: Restrict)
  barberoId                Int
  barbero                  BarberProfile @relation("BarberoCitas", fields: [barberoId], references: [id])
  servicioId               String?
  servicio                 Service?      @relation(fields: [servicioId], references: [id], onDelete: Restrict)
  // UTC instants via Prisma. Keep existing timestamp(3) values unchanged;
  // America/Santiago is applied at calendar/API boundaries, never by shifting rows.
  fecha_hora               DateTime
  disponibleHasta          DateTime?
  duracionReservada        Int?
  nombreServicioReservado   String?
  precioReservado           Int?
  estado                   CitaEstado    @default(disponible)
  comprobanteTransferencia String?
  comprobanteNombre        String?
  fecha_creacion           DateTime      @default(now())
  fecha_actualizacion      DateTime      @default(now()) @updatedAt
  cambiosEstado            CitaCambioEstado[]

  @@index([barberoId, estado, fecha_hora])
}

model CitaCambioEstado {
  id             String     @id @default(uuid())
  citaId         String
  cita           Cita       @relation(fields: [citaId], references: [id], onDelete: Restrict)
  estadoAnterior CitaEstado?
  estadoNuevo    CitaEstado
  fecha          DateTime   @default(now())
  responsableId  Int?
  responsable    User?      @relation(fields: [responsableId], references: [id], onDelete: Restrict)
  // "migracion" is a baseline, not a reconstructed historical transition.
  origen         String     @default("aplicacion")

  @@index([citaId, fecha])
}

model Conversation {
  id        String    @id @default(uuid())
  clientId  Int
  client    User      @relation("ClientConversations", fields: [clientId], references: [id], onDelete: Cascade)
  barberId  Int
  barber    User      @relation("BarberConversations", fields: [barberId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]

  @@unique([clientId, barberId])
  @@index([clientId, updatedAt])
  @@index([barberId, updatedAt])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       Int
  sender         User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  content        String
  read           Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}
