# Backend Environment Variables
# TODO: Cambiar valores en producción

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=taller
DATABASE_URL=postgresql://postgres:REEMPLAZAR@localhost:5432/taller

# JWT
JWT_SECRET=
JWT_EXPIRE=7d

# Server
#PORT=3000
#NODE_ENV=development

# CORS
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Genera JWT_SECRET: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# SEED_DEMO_PASSWORD solo se utiliza al ejecutar manualmente el seed de desarrollo.
